# SMTP details for registration confirmation emails. Add real values only in the
# deployment service's environment-variable settings; never commit the real .env file.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
MAIL_FROM="Swedish For All <no-reply@swedishforall.com>"
